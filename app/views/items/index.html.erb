<!-- app/views/items/index.html.erb -->
<h1>商品一覧</h1>

<div class="item-list">
  <% if @items.present? %>
    <% @items.each do |item| %>
      <div class="item-card">
        <%# 商品詳細ページへリンク %>
        <%= link_to item_path(item) do %>
          <div class="item-image-wrapper">
            <% if item.image.attached? %>
              <%= image_tag item.image, class: "item-image" %>
            <% else %>
              <%= image_tag "dummy.png", alt: "No image", class: "item-image" %>
            <% end %>

            <%# 売却済みの場合は「SOLD OUT」を表示 %>
            <% if item.order.present? %>
              <div class="sold-out">SOLD OUT</div>
            <% end %>
          </div>
        <% end %>

        <div class="item-info">
          <p class="item-name"><%= item.name %></p>
          <p class="item-price">
            ¥<%= item.price.to_s(:delimited) %>（<%= item.shipping_fee.name %>）
          </p>
        </div>
      </div>
    <% end %>
  <% else %>
    <%# 商品が存在しない場合（ダミー表示） %>
    <div class="dummy-item">
      <%= image_tag "dummy.png", alt: "No items" %>
      <p>まだ商品がありません</p>
    </div>
  <% end %>
</div>
